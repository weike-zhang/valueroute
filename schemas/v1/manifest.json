{
  "schema_version": "v1",
  "media_type": "application/schema+json",
  "source": "valueroute.api.schemas",
  "schemas": {
    "CreateSessionRequest": "create-session-request.json",
    "RegisterEpochRequest": "register-epoch-request.json",
    "CreateTaskRequest": "create-task-request.json",
    "VerifyTaskRequest": "verify-task-request.json",
    "RecordEvidenceRequest": "record-evidence-request.json",
    "OwnerReviewRequest": "owner-review-request.json",
    "VerifyReviewRequest": "verify-review-request.json",
    "RequestApprovalRequest": "request-approval-request.json",
    "DecideApprovalRequest": "decide-approval-request.json",
    "ControlTaskRequest": "control-task-request.json",
    "SubmitPlanRequest": "submit-plan-request.json",
    "AdvisoryRequest": "advisory-request.json"
  },
  "routes": {
    "POST /v1/controller-sessions": "CreateSessionRequest",
    "POST /v1/controller-sessions/{session_id}/epochs": "RegisterEpochRequest",
    "POST /v1/tasks": "CreateTaskRequest",
    "POST /v1/tasks/{task_id}/verify": "VerifyTaskRequest",
    "POST /v1/tasks/{task_id}/evidence": "RecordEvidenceRequest",
    "POST /v1/tasks/{task_id}/approvals": "RequestApprovalRequest",
    "POST /v1/tasks/{task_id}/approvals/{approval_id}": "DecideApprovalRequest",
    "POST /v1/tasks/{task_id}/execute": "ControlTaskRequest",
    "POST /v1/tasks/{task_id}/pause": "ControlTaskRequest",
    "POST /v1/tasks/{task_id}/resume": "ControlTaskRequest",
    "POST /v1/tasks/{task_id}/cancel": "ControlTaskRequest",
    "POST /v1/tasks/{task_id}/plan": "SubmitPlanRequest",
    "POST /v1/tasks/{task_id}/children/{child_task_id}/review": "OwnerReviewRequest",
    "POST /v1/tasks/{task_id}/children/{child_task_id}/reviews/{review_id}/verify": "VerifyReviewRequest",
    "POST /v1/advisory": "AdvisoryRequest"
  }
}
