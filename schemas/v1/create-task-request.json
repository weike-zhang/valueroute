{
  "$defs": {
    "AcceptanceRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "AcceptanceRequest",
      "type": "object"
    },
    "BudgetsRequest": {
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Tokens"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_wall_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Time Seconds"
        }
      },
      "title": "BudgetsRequest",
      "type": "object"
    },
    "WorkspaceRequest": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "default": "local",
          "maxLength": 120,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "canonical_uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Canonical Uri",
          "type": "string"
        },
        "base_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Base Revision",
          "type": "string"
        }
      },
      "required": [
        "canonical_uri",
        "base_revision"
      ],
      "title": "WorkspaceRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "controller_session_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Controller Session Id",
      "type": "string"
    },
    "request_type": {
      "enum": [
        "new_task",
        "material_amendment",
        "continuation",
        "clarification",
        "control"
      ],
      "title": "Request Type",
      "type": "string"
    },
    "goal": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "acceptance_contract": {
      "items": {
        "$ref": "#/$defs/AcceptanceRequest"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Acceptance Contract",
      "type": "array"
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Data Classification",
      "type": "string"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceRequest"
    },
    "budgets": {
      "$ref": "#/$defs/BudgetsRequest"
    }
  },
  "required": [
    "controller_session_id",
    "request_type",
    "goal",
    "acceptance_contract",
    "data_classification",
    "workspace"
  ],
  "title": "CreateTaskRequest",
  "type": "object"
}
